# Hugging Face token, needed to download ImageNet (gated dataset ILSVRC/imagenet-1k).
# Request access and accept the terms at https://huggingface.co/datasets/ILSVRC/imagenet-1k
HF_TOKEN=your_huggingface_token_here

# Root data directory. ImageNet is cached to DATA_DIR/datasets, the rendered scenes to
# DATA_DIR/datasets/rendered (see RENDERED_DIR), and the optional Dryad release to
# DATA_DIR/dryad. A trailing slash is fine.
DATA_DIR=/path/to/your/data/directory/

# Where model weights (e.g. DreamSim) are cached. Defaults to DATA_DIR/models.
MODELS_DIR=${DATA_DIR}/models

# Regenerated analysis outputs (screening ordered responses/indices, DreamSim embeddings,
# similarity results, per-twin masks, synthesis), organized as {area}/{backbone}/ subfolders
# (e.g. DUAL-FEATURE-ANALYSIS/v4/resnet/). Created on demand.
ANALYSIS_DIR=${DATA_DIR}/DUAL-FEATURE-ANALYSIS

# Base dir for generated figures (created on demand), organized as {area}/{backbone}/.
PAPER_FIG_DIR=/path/to/dualneuron-solid/figs

# Base dir for run logs (created on demand), organized as {area}/{backbone}/.
LOGS_DIR=/path/to/dualneuron-solid/logs

# Where ImageNet is cached (HuggingFace datasets cache; downloaded on first run).
IMAGENET_CACHE_DIR=${DATA_DIR}/datasets

# Where the rendered scenes live (Dryad batch_*.zip archives, read directly).
RENDERED_DIR=${DATA_DIR}/datasets/rendered

# Experiment dataset, per area: recorded sessions + presented stimuli under
# experiment/{v4,v1}/{trials,images} (e.g. experiment/v4/trials/*.pickle,
# experiment/v4/images/{id:06d}.npy). Used by dualneuron.data.recordings and the recorded figures.
EXPERIMENT_DIR=${DATA_DIR}/datasets/experiment

# Cached training inputs (created on demand), per area/backbone/split: frozen-core feature maps for
# frozen twins (e.g. features/v4/dino/test_features_block04.npy) or transformed images for fine-tuned
# twins (features/v1/convnext/train_images_093.npy). Reused across all ensemble members and sweeps.
FEATURES_DIR=${DATA_DIR}/features

# Trained twin ensembles written by dualneuron.training (created on demand): one folder per
# area/backbone (e.g. trained_models/v4/dino/), each holding the 5 member weights named
# {area}_{backbone}_{i}.pth.tar plus correlations.npy and mask.npy.
TRAINED_MODELS_DIR=${DATA_DIR}/trained_models

# Note: the gated DINOv3 backbone (hubconf repo + converted weights) lives under
# MODELS_DIR/dinov3 — see the README for the one-time, license-gated download/conversion.
